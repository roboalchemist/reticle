#!/bin/sh

set -eu

service_label="io.github.roboalchemist.reticle-mlx"
legacy_service_label="io.github.roboalchemist.reticle.seed-mlx"
command_name="${0##*/}"
service_uid="$(id -u)"
service_domain="gui/${service_uid}"
service_target="${service_domain}/${service_label}"
legacy_service_target="${service_domain}/${legacy_service_label}"
plist_path="${HOME}/Library/LaunchAgents/${service_label}.plist"
legacy_plist_path="${HOME}/Library/LaunchAgents/${legacy_service_label}.plist"
data_dir="${RETICLE_MLX_HOME:-${HOME}/.reticle/mlx}"
venv_path="${RETICLE_MLX_VENV:-${data_dir}/venv}"
log_dir="${RETICLE_MLX_LOG_DIR:-${data_dir}/logs}"
stdout_log="${log_dir}/server.log"
stderr_log="${log_dir}/server.error.log"
model="${RETICLE_MLX_MODEL:-roboalchemist/Seed-Coder-8B-Base-MLX-mixed-3-4}"
configured_model="${model}"
api_model="${RETICLE_MLX_API_MODEL:-default_model}"
fim_format="${RETICLE_MLX_FIM_FORMAT:-seed}"
port="${RETICLE_MLX_PORT:-8001}"
prompt_cache_size="${RETICLE_MLX_PROMPT_CACHE_SIZE:-8}"
prompt_cache_bytes="${RETICLE_MLX_PROMPT_CACHE_BYTES:-4294967296}"
mlx_lm_version="${RETICLE_MLX_MLX_LM_VERSION:-0.31.1}"
mlx_version="${RETICLE_MLX_MLX_VERSION:-0.30.5}"

usage() {
  cat <<EOF
Usage: ${command_name} COMMAND

Commands:
  install     Install the MLX runtime, selected model, and user LaunchAgent
  download    Download the selected model without changing the running service
  model-status
              Report whether the selected model is completely cached
  start       Load the installed LaunchAgent and warm the FIM path
  stop        Unload the LaunchAgent without deleting it
  restart     Restart the LaunchAgent and warm the FIM path
  status      Show installed model, format, launchd state, and server health
  health      Print GET /health
  monitor     Watch compact launchd and health state until interrupted
  logs        Follow service stdout and stderr
  doctor      Validate the runtime, service, endpoint, and real FIM behavior
  vscode-install
              Install or update the Reticle VS Code extension
  vscode-doctor
              Check the extension, user settings, endpoint, and real FIM behavior
  uninstall   Remove the LaunchAgent; runtime, model cache, and logs are preserved

Environment:
  RETICLE_MLX_MODEL              Hugging Face model ID or local MLX model path
  RETICLE_MLX_FIM_FORMAT         Reticle transport: codestral, seed, qwen, or openai
  RETICLE_MLX_PORT               Loopback port (default: 8001)
  RETICLE_MLX_PROMPT_CACHE_SIZE  Distinct MLX KV caches to retain (default: 8)
  RETICLE_MLX_PROMPT_CACHE_BYTES Maximum KV cache memory in bytes (default: 4294967296)
  RETICLE_MLX_MLX_LM_VERSION     MLX-LM version in the private venv (default: 0.31.1)
  RETICLE_MLX_MLX_VERSION        MLX runtime paired with MLX-LM (default: 0.30.5)
  RETICLE_MLX_PYTHON             Python 3 executable used to create the private venv
  RETICLE_MLX_HOME               Runtime directory (default: ~/.reticle/mlx)
  RETICLE_MLX_VENV               Private Python environment override
  RETICLE_MLX_LOG_DIR            Log directory override
  RETICLE_MLX_SKIP_DOWNLOAD      Set to 1 when the selected model is already cached
  RETICLE_MLX_SKIP_FIM_WARMUP    Set to 1 to skip the Reticle-shaped warmup request
  RETICLE_MLX_MONITOR_INTERVAL   Monitor refresh interval in seconds (default: 2)
  RETICLE_CODE_BIN               VS Code command-line executable override
  RETICLE_CODE_SETTINGS          VS Code user settings.json override
EOF
}

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

validate_positive_integer() {
  value="${1}"
  name="${2}"
  case "${value}" in
    ''|*[!0-9]*) fail "${name} must be a positive integer" ;;
  esac
  [ "${value}" -gt 0 ] || fail "${name} must be a positive integer"
}

validate_options() {
  validate_positive_integer "${port}" "RETICLE_MLX_PORT"
  [ "${port}" -le 65535 ] || fail "RETICLE_MLX_PORT must be at most 65535"
  validate_positive_integer "${prompt_cache_size}" "RETICLE_MLX_PROMPT_CACHE_SIZE"
  validate_positive_integer "${prompt_cache_bytes}" "RETICLE_MLX_PROMPT_CACHE_BYTES"
  case "${fim_format}" in
    codestral|seed|qwen|openai) ;;
    *) fail "RETICLE_MLX_FIM_FORMAT must be codestral, seed, qwen, or openai" ;;
  esac
}

validate_platform() {
  [ "$(uname -s)" = "Darwin" ] || fail "Reticle MLX requires macOS"
  [ "$(uname -m)" = "arm64" ] || fail "Reticle MLX requires an Apple Silicon Mac"
}

resolve_python() {
  if [ -n "${RETICLE_MLX_PYTHON:-}" ]; then
    [ -x "${RETICLE_MLX_PYTHON}" ] ||
      fail "RETICLE_MLX_PYTHON is not executable: ${RETICLE_MLX_PYTHON}"
    printf '%s\n' "${RETICLE_MLX_PYTHON}"
    return
  fi
  for candidate in /opt/homebrew/bin/python3.12 /opt/homebrew/bin/python3 /usr/local/bin/python3.12; do
    if [ -x "${candidate}" ]; then
      printf '%s\n' "${candidate}"
      return
    fi
  done
  if command -v python3 >/dev/null 2>&1; then
    command -v python3
    return
  fi
  fail "Python 3 was not found. Install it with: brew install python@3.12"
}

resolve_server() {
  server_path="${venv_path}/bin/mlx_lm.server"
  [ -x "${server_path}" ] || return 1
  printf '%s\n' "${server_path}"
}

install_runtime() {
  python_path="$(resolve_python)"
  mkdir -p "${data_dir}"
  if [ ! -x "${venv_path}/bin/python" ]; then
    "${python_path}" -m venv "${venv_path}"
  fi
  if runtime_versions="$(
    "${venv_path}/bin/python" -c \
      'import importlib.metadata; print(importlib.metadata.version("mlx-lm"), importlib.metadata.version("mlx"))' \
      2>/dev/null
  )" &&
    [ "${runtime_versions}" = "${mlx_lm_version} ${mlx_version}" ]; then
    printf 'MLX runtime is ready (mlx-lm=%s, mlx=%s).\n' \
      "${mlx_lm_version}" "${mlx_version}"
    return
  fi
  printf 'Preparing the private MLX runtime...\n'
  "${venv_path}/bin/python" -m pip install --disable-pip-version-check --upgrade \
    "mlx==${mlx_version}" "mlx-lm==${mlx_lm_version}"
}

download_model() {
  if [ "${RETICLE_MLX_SKIP_DOWNLOAD:-0}" = "1" ]; then
    printf 'Model download skipped by RETICLE_MLX_SKIP_DOWNLOAD.\n'
    return
  fi
  if [ -d "${model}" ]; then
    printf 'RETICLE_DOWNLOAD_PROGRESS\t{"downloadedBytes":1,"totalBytes":1,"file":"Local model","stage":"complete"}\n'
    return
  fi
  printf 'Downloading %s...\n' "${model}"
  download_worker=""
  terminate_download() {
    if [ -n "${download_worker}" ]; then
      kill -TERM "${download_worker}" 2>/dev/null || true
    fi
    exit 143
  }
  trap terminate_download HUP INT TERM
  "${venv_path}/bin/python" - "${model}" <<'PY' &
import json
import sys
import time

from huggingface_hub import HfApi, hf_hub_download
from tqdm.auto import tqdm

repo_id = sys.argv[1]
api = HfApi()


def emit(downloaded, total, filename, stage):
    print(
        "RETICLE_DOWNLOAD_PROGRESS\t"
        + json.dumps(
            {
                "downloadedBytes": int(downloaded),
                "totalBytes": int(total),
                "file": filename,
                "stage": stage,
            },
            separators=(",", ":"),
        ),
        flush=True,
    )


emit(0, 0, "Reading model metadata", "metadata")
info = api.model_info(repo_id, files_metadata=True)
files = [
    sibling
    for sibling in info.siblings
    if sibling.rfilename and sibling.rfilename != ".gitattributes"
]
total_bytes = sum(max(0, int(sibling.size or 0)) for sibling in files)
completed_bytes = 0
current_size = 0
current_file = ""
last_emit = 0.0


class AggregateProgress(tqdm):
    def display(self, msg=None, pos=None):
        global last_emit
        now = time.monotonic()
        if now - last_emit >= 0.1 or self.n >= (self.total or 0):
            emit(
                completed_bytes + min(int(self.n), current_size),
                total_bytes,
                current_file,
                "downloading",
            )
            last_emit = now


emit(0, total_bytes, "Starting download", "downloading")
for sibling in files:
    current_file = sibling.rfilename
    current_size = max(0, int(sibling.size or 0))
    emit(completed_bytes, total_bytes, current_file, "downloading")
    hf_hub_download(
        repo_id=repo_id,
        filename=current_file,
        revision=info.sha,
        tqdm_class=AggregateProgress,
    )
    completed_bytes += current_size
    emit(completed_bytes, total_bytes, current_file, "downloading")

emit(total_bytes or 1, total_bytes or 1, "Download complete", "complete")
PY
  download_worker=$!
  printf 'RETICLE_DOWNLOAD_WORKER\t%s\n' "${download_worker}"
  if wait "${download_worker}"; then
    download_worker=""
    trap - HUP INT TERM
    printf 'Downloaded %s.\n' "${model}"
  else
    download_status=$?
    download_worker=""
    trap - HUP INT TERM
    return "${download_status}"
  fi
}

model_status() {
  if [ -d "${model}" ]; then
    printf 'downloaded\t%s\n' "${model}"
    return
  fi
  if [ ! -x "${venv_path}/bin/python" ]; then
    printf 'missing\t%s\n' "${model}"
    return 1
  fi
  "${venv_path}/bin/python" - "${model}" <<'PY'
import sys
from pathlib import Path

from huggingface_hub import try_to_load_from_cache
from huggingface_hub.file_download import _CACHED_NO_EXIST

model = sys.argv[1]
config = try_to_load_from_cache(model, "config.json")
if config is None or config is _CACHED_NO_EXIST:
    print(f"missing\t{model}")
    raise SystemExit(1)

snapshot = Path(config).parent
has_weights = any(snapshot.glob("*.safetensors"))
has_tokenizer = any(snapshot.glob("tokenizer*"))
if has_weights and has_tokenizer:
    print(f"downloaded\t{model}")
else:
    print(f"partial\t{model}")
    raise SystemExit(1)
PY
}

prepare_server_model() {
  if [ "${fim_format}" != "codestral" ] || [ -d "${model}" ]; then
    printf '%s\n' "${model}"
    return
  fi
  printf 'Preparing the official Codestral v3 FIM tokenizer overlay...\n' >&2
  "${venv_path}/bin/python" - "${model}" "${data_dir}" <<'PY'
import os
import shutil
import sys
from pathlib import Path

from huggingface_hub import hf_hub_download, try_to_load_from_cache

model_id, data_dir = sys.argv[1:]
cached_config = try_to_load_from_cache(model_id, "config.json")
if not isinstance(cached_config, str):
    raise RuntimeError(f"Codestral model is not completely cached: {model_id}")
source = Path(cached_config).parent
official_tokenizer = Path(
    hf_hub_download(
        "mistralai/Codestral-22B-v0.1",
        filename="tokenizer.model.v3",
    )
)
destination = Path(data_dir) / "prepared-models" / "codestral-22b-v0.1-4bit"
destination.mkdir(parents=True, exist_ok=True)

tokenizer_files = {
    "tokenizer.json",
    "tokenizer.model",
    "tokenizer.model.v3",
    "tokenizer_config.json",
    "special_tokens_map.json",
}
for source_file in source.iterdir():
    if source_file.name in tokenizer_files:
        continue
    target = destination / source_file.name
    desired = source_file.resolve()
    if target.is_symlink() and target.resolve() == desired:
        continue
    if target.exists() or target.is_symlink():
        target.unlink()
    target.symlink_to(desired)

for name in ("tokenizer_config.json", "special_tokens_map.json"):
    shutil.copy2(source / name, destination / name)
shutil.copy2(official_tokenizer, destination / "tokenizer.model")
print(destination)
PY
}

resolve_code_cli() {
  if [ -n "${RETICLE_CODE_BIN:-}" ]; then
    [ -x "${RETICLE_CODE_BIN}" ] || return 1
    printf '%s\n' "${RETICLE_CODE_BIN}"
    return
  fi
  for candidate in /opt/homebrew/bin/code /usr/local/bin/code; do
    if [ -x "${candidate}" ]; then
      printf '%s\n' "${candidate}"
      return
    fi
  done
  candidate="/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
  if [ -x "${candidate}" ]; then
    printf '%s\n' "${candidate}"
    return
  fi
  candidate="${HOME}/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code"
  if [ -x "${candidate}" ]; then
    printf '%s\n' "${candidate}"
    return
  fi
  return 1
}

install_vscode_extension() {
  code_cli="$(resolve_code_cli)" ||
    fail "Visual Studio Code was not found. Install it from https://code.visualstudio.com/"
  printf 'Installing the Reticle VS Code extension...\n'
  "${code_cli}" --install-extension roboalchemist.reticle --force
}

check_vscode_settings() {
  settings_path="${RETICLE_CODE_SETTINGS:-${HOME}/Library/Application Support/Code/User/settings.json}"
  if [ ! -f "${settings_path}" ]; then
    printf 'FAIL VS Code settings: missing %s\n' "${settings_path}" >&2
    return 1
  fi
  python_path="$(resolve_python)"
  "${python_path}" - "${settings_path}" "${base_url}/v1" "${api_model}" "${fim_format}" <<'PY'
import json
import re
import sys
from pathlib import Path

path, expected_url, expected_model, expected_format = sys.argv[1:]
text = Path(path).read_text(encoding="utf-8")
ok = True
for key, expected in (
    ("reticle.baseURL", expected_url),
    ("reticle.model", expected_model),
    ("reticle.fimFormat", expected_format),
):
    match = re.search(r'"' + re.escape(key) + r'"\s*:\s*("(?:\\.|[^"\\])*")', text)
    if match is None:
        print(f"FAIL VS Code setting: {key} is not set", file=sys.stderr)
        ok = False
        continue
    actual = json.loads(match.group(1))
    if actual != expected:
        print(
            f"FAIL VS Code setting: {key} expected {expected!r}, got {actual!r}",
            file=sys.stderr,
        )
        ok = False
    else:
        print(f"PASS VS Code setting: {key}={actual}")
raise SystemExit(0 if ok else 1)
PY
}

run_vscode_doctor() {
  vscode_ok=1
  printf 'Reticle VS Code doctor\n'
  if code_cli="$(resolve_code_cli)"; then
    printf 'PASS VS Code CLI: %s\n' "${code_cli}"
    extension_list="$("${code_cli}" --list-extensions --show-versions 2>/dev/null || true)"
    extension_version="$(
      printf '%s\n' "${extension_list}" |
        awk -F@ 'tolower($1) == "roboalchemist.reticle" { print $2; exit }'
    )"
    if [ -n "${extension_version}" ]; then
      printf 'PASS extension: roboalchemist.reticle@%s\n' "${extension_version}"
    else
      printf 'FAIL extension: roboalchemist.reticle is not installed\n' >&2
      vscode_ok=0
    fi
  else
    printf 'FAIL VS Code CLI: Visual Studio Code was not found\n' >&2
    vscode_ok=0
  fi

  check_vscode_settings || vscode_ok=0

  if health_response="$(curl -fsS --max-time 5 "${base_url}/health")"; then
    health_status="$(printf '%s' "${health_response}" | json_value status || true)"
    health_ok="$(printf '%s' "${health_response}" | json_value ok || true)"
  else
    health_status=""
    health_ok=""
  fi
  if [ "${health_status}" = "ok" ] || [ "${health_ok}" = "true" ]; then
    printf 'PASS endpoint: %s/health\n' "${base_url}"
  else
    printf 'FAIL endpoint: GET %s/health failed\n' "${base_url}" >&2
    vscode_ok=0
  fi

  if fim_response="$(curl -fsS --max-time 180 "${base_url}/v1/completions" \
    -H 'Content-Type: application/json' -d "$(make_fim_payload)")" &&
    completion="$(
      printf '%s' "${fim_response}" | json_value choices.0.text || true
    )" &&
    completion_starts_with_probe_identifier "${completion}"; then
    printf 'PASS extension-shaped FIM probe: suffixOnlyIdentifier\n'
  else
    printf 'FAIL extension-shaped FIM probe: expected suffixOnlyIdentifier\n' >&2
    vscode_ok=0
  fi

  [ "${vscode_ok}" -eq 1 ] || exit 1
  printf 'Reticle VS Code doctor: pass\n'
}

xml_escape() {
  printf '%s' "$1" |
    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' \
      -e 's/"/\&quot;/g' -e "s/'/\&apos;/g"
}

write_plist() {
  server_path="${1}"
  server_model="${2}"
  mkdir -p "$(dirname "${plist_path}")" "${log_dir}"
  plist_tmp="$(mktemp "${plist_path}.XXXXXX")"
  escaped_server="$(xml_escape "${server_path}")"
  escaped_model="$(xml_escape "${server_model}")"
  escaped_configured_model="$(xml_escape "${configured_model}")"
  escaped_format="$(xml_escape "${fim_format}")"
  escaped_stdout="$(xml_escape "${stdout_log}")"
  escaped_stderr="$(xml_escape "${stderr_log}")"
  escaped_path="$(xml_escape "${venv_path}/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin")"
  cat >"${plist_tmp}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${service_label}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${escaped_server}</string>
    <string>--model</string>
    <string>${escaped_model}</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>${port}</string>
    <string>--max-tokens</string>
    <string>256</string>
    <string>--prompt-cache-size</string>
    <string>${prompt_cache_size}</string>
    <string>--prompt-cache-bytes</string>
    <string>${prompt_cache_bytes}</string>
    <string>--log-level</string>
    <string>INFO</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>${escaped_path}</string>
    <key>RETICLE_MLX_FIM_FORMAT</key>
    <string>${escaped_format}</string>
    <key>RETICLE_MLX_CONFIGURED_MODEL</key>
    <string>${escaped_configured_model}</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>${escaped_stdout}</string>
  <key>StandardErrorPath</key>
  <string>${escaped_stderr}</string>
</dict>
</plist>
EOF
  plutil -lint "${plist_tmp}" >/dev/null
  chmod 600 "${plist_tmp}"
  mv "${plist_tmp}" "${plist_path}"
}

installed_config_value() {
  option_name="${1}"
  argument_count="$(plutil -extract ProgramArguments raw -o - "${plist_path}" 2>/dev/null)" ||
    return 1
  case "${argument_count}" in
    ''|*[!0-9]*) return 1 ;;
  esac
  argument_index=0
  while [ "${argument_index}" -lt "${argument_count}" ]; do
    argument_value="$(
      plutil -extract "ProgramArguments.${argument_index}" raw -o - "${plist_path}" 2>/dev/null
    )" || return 1
    if [ "${argument_value}" = "${option_name}" ]; then
      value_index=$((argument_index + 1))
      [ "${value_index}" -lt "${argument_count}" ] || return 1
      plutil -extract "ProgramArguments.${value_index}" raw -o - "${plist_path}" 2>/dev/null
      return
    fi
    argument_index=$((argument_index + 1))
  done
  return 1
}

load_installed_config() {
  [ -f "${plist_path}" ] || return
  if [ -z "${RETICLE_MLX_MODEL+x}" ]; then
    installed_value="$(
      plutil -extract EnvironmentVariables.RETICLE_MLX_CONFIGURED_MODEL raw -o - \
        "${plist_path}" 2>/dev/null || true
    )"
    if [ -z "${installed_value}" ]; then
      installed_value="$(installed_config_value --model || true)"
    fi
    [ -z "${installed_value}" ] || model="${installed_value}"
    configured_model="${model}"
  fi
  if [ -z "${RETICLE_MLX_PORT+x}" ]; then
    installed_value="$(installed_config_value --port || true)"
    [ -z "${installed_value}" ] || port="${installed_value}"
  fi
  if [ -z "${RETICLE_MLX_PROMPT_CACHE_SIZE+x}" ]; then
    installed_value="$(installed_config_value --prompt-cache-size || true)"
    [ -z "${installed_value}" ] || prompt_cache_size="${installed_value}"
  fi
  if [ -z "${RETICLE_MLX_PROMPT_CACHE_BYTES+x}" ]; then
    installed_value="$(installed_config_value --prompt-cache-bytes || true)"
    [ -z "${installed_value}" ] || prompt_cache_bytes="${installed_value}"
  fi
  if [ -z "${RETICLE_MLX_FIM_FORMAT+x}" ]; then
    installed_value="$(
      plutil -extract EnvironmentVariables.RETICLE_MLX_FIM_FORMAT raw -o - \
        "${plist_path}" 2>/dev/null || true
    )"
    [ -z "${installed_value}" ] || fim_format="${installed_value}"
  fi
}

service_loaded() {
  launchctl print "${service_target}" >/dev/null 2>&1
}

load_service() {
  [ -f "${plist_path}" ] || fail "service is not installed: ${plist_path}"
  if service_loaded; then
    launchctl kickstart -k "${service_target}"
  else
    launchctl bootstrap "${service_domain}" "${plist_path}"
  fi
}

unload_service() {
  if service_loaded; then
    launchctl bootout "${service_target}"
    sleep 1
  fi
}

unload_legacy_service() {
  if launchctl print "${legacy_service_target}" >/dev/null 2>&1; then
    printf 'Stopping the legacy Reticle Seed MLX service...\n'
    launchctl bootout "${legacy_service_target}"
    sleep 1
  fi
}

finish_legacy_migration() {
  if [ -f "${legacy_plist_path}" ]; then
    rm -f "${legacy_plist_path}"
    printf 'Removed the legacy service definition; its runtime and logs remain under ~/.reticle/seed-mlx.\n'
  fi
}

wait_for_health() {
  attempt=0
  while [ "${attempt}" -lt 300 ]; do
    if curl -fsS --max-time 2 "${base_url}/health" >/dev/null 2>&1; then
      printf 'Reticle MLX is healthy at %s\n' "${base_url}"
      return
    fi
    attempt=$((attempt + 1))
    sleep 2
  done
  printf 'Reticle MLX did not become healthy; inspect %s and %s\n' \
    "${stdout_log}" "${stderr_log}" >&2
  exit 1
}

make_fim_payload() {
  python_path="$(resolve_python)"
  "${python_path}" - "${api_model}" "${fim_format}" <<'PY'
import json
import sys

model, fim_format = sys.argv[1:]
prefix = "function select(user: User) {\n  const value = user."
suffix = ";\n  return value;\n}\ninterface User { suffixOnlyIdentifier: string }\n"

if fim_format == "seed":
    prompt = f"<[fim-suffix]>{suffix}<[fim-prefix]>{prefix}<[fim-middle]>"
    request_suffix = ""
    stop = ["\n"]
elif fim_format == "qwen":
    prompt = f"<|fim_prefix|>{prefix}<|fim_suffix|>{suffix}<|fim_middle|>"
    request_suffix = ""
    stop = ["\n", "<|fim_pad|>", "<|endoftext|>"]
elif fim_format == "codestral":
    prompt = f"[SUFFIX]{suffix}[PREFIX]{prefix}"
    request_suffix = ""
    stop = [suffix.splitlines()[0] or "\n", "</s>"]
else:
    prompt = prefix
    request_suffix = suffix
    stop = ["\n"]

print(
    json.dumps(
        {
            "model": model,
            "prompt": prompt,
            "suffix": request_suffix,
            "max_tokens": 8,
            "temperature": 0,
            "stream": False,
            "stop": stop,
        }
    )
)
PY
}

warm_fim_path() {
  [ "${RETICLE_MLX_SKIP_FIM_WARMUP:-0}" = "1" ] && return
  printf 'Warming the Reticle %s FIM request path...\n' "${fim_format}"
  curl -fsS --max-time 180 "${base_url}/v1/completions" \
    -H 'Content-Type: application/json' \
    -d "$(make_fim_payload)" >/dev/null ||
    fail "Reticle MLX is healthy but the FIM warmup failed; inspect ${stderr_log}"
  printf 'Reticle FIM request path is warm.\n'
}

json_value() {
  plutil -extract "${1}" raw -o - - 2>/dev/null
}

completion_starts_with_probe_identifier() {
  case "${1}" in
    suffixOnlyIdentifier | suffixOnlyIdentifier[!A-Za-z0-9_]*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

run_doctor() {
  doctor_ok=1
  printf 'Reticle MLX doctor\n'
  printf 'configured endpoint: %s\n' "${base_url}"
  printf 'configured model: %s\n' "${model}"
  printf 'configured FIM format: %s\n' "${fim_format}"
  printf 'configured cache: entries=%s bytes=%s\n' \
    "${prompt_cache_size}" "${prompt_cache_bytes}"

  if server_path="$(resolve_server)"; then
    printf 'PASS executable: %s\n' "${server_path}"
  else
    printf 'FAIL executable: %s/bin/mlx_lm.server is missing\n' "${venv_path}" >&2
    doctor_ok=0
  fi

  runtime_versions=""
  if runtime_versions="$(
    "${venv_path}/bin/python" -c \
      'import importlib.metadata; print(importlib.metadata.version("mlx-lm"), importlib.metadata.version("mlx"))' \
      2>/dev/null
  )"; then
    installed_mlx_lm="${runtime_versions%% *}"
    installed_mlx="${runtime_versions#* }"
    if [ "${installed_mlx_lm}" = "${mlx_lm_version}" ] &&
      [ "${installed_mlx}" = "${mlx_version}" ]; then
      printf 'PASS runtime: mlx-lm=%s mlx=%s\n' "${installed_mlx_lm}" "${installed_mlx}"
    else
      printf 'FAIL runtime: expected mlx-lm=%s mlx=%s, got mlx-lm=%s mlx=%s; rerun install\n' \
        "${mlx_lm_version}" "${mlx_version}" \
        "${installed_mlx_lm}" "${installed_mlx}" >&2
      doctor_ok=0
    fi
  else
    printf 'FAIL runtime: could not read MLX-LM and MLX versions\n' >&2
    doctor_ok=0
  fi

  if [ -f "${plist_path}" ]; then
    printf 'PASS service definition: %s\n' "${plist_path}"
  else
    printf 'FAIL service definition: missing %s\n' "${plist_path}" >&2
    doctor_ok=0
  fi

  if service_loaded; then
    printf 'PASS launchd: loaded (%s)\n' "${service_target}"
  else
    printf 'FAIL launchd: not loaded (%s)\n' "${service_target}" >&2
    doctor_ok=0
  fi

  health_response=""
  if health_response="$(curl -fsS --max-time 5 "${base_url}/health")"; then
    health_status="$(printf '%s' "${health_response}" | json_value status || true)"
    if [ "${health_status}" = "ok" ]; then
      printf 'PASS health: status=ok\n'
    else
      printf 'FAIL health: expected status=ok, got %s\n' \
        "${health_status:-unknown}" >&2
      doctor_ok=0
    fi
  else
    printf 'FAIL health: GET %s/health failed\n' "${base_url}" >&2
    doctor_ok=0
  fi

  fim_response=""
  if fim_response="$(curl -fsS --max-time 180 "${base_url}/v1/completions" \
    -H 'Content-Type: application/json' -d "$(make_fim_payload)")"; then
    completion="$(printf '%s' "${fim_response}" | json_value choices.0.text || true)"
    if completion_starts_with_probe_identifier "${completion}"; then
      printf 'PASS FIM probe: suffixOnlyIdentifier\n'
    else
      printf 'FAIL FIM probe: expected suffixOnlyIdentifier, got %s\n' \
        "${completion:-no completion}" >&2
      doctor_ok=0
    fi
  else
    printf 'FAIL FIM probe: POST %s/v1/completions failed\n' "${base_url}" >&2
    doctor_ok=0
  fi

  [ "${doctor_ok}" -eq 1 ] || exit 1
  printf 'Reticle MLX doctor: pass\n'
}

print_json() {
  if command -v jq >/dev/null 2>&1; then
    jq .
  else
    cat
  fi
}

command="${1:-}"
case "${command}" in
  start|restart|status|health|monitor|doctor|vscode-doctor)
    load_installed_config
    ;;
esac
base_url="http://127.0.0.1:${port}"
validate_options

case "${command}" in
  install)
    validate_platform
    unload_legacy_service
    install_runtime
    download_model
    server_model="$(prepare_server_model)"
    server_path="$(resolve_server)" ||
      fail "MLX-LM server was not installed in ${venv_path}"
    unload_service
    write_plist "${server_path}" "${server_model}"
    load_service
    wait_for_health
    warm_fim_path
    finish_legacy_migration
    ;;
  download)
    validate_platform
    install_runtime
    download_model
    prepare_server_model >/dev/null
    ;;
  model-status)
    model_status
    ;;
  start)
    load_service
    wait_for_health
    warm_fim_path
    ;;
  stop)
    unload_service
    printf 'Reticle MLX service stopped; plist preserved at %s\n' "${plist_path}"
    ;;
  restart)
    load_service
    wait_for_health
    warm_fim_path
    ;;
  status)
    status_ok=1
    printf 'endpoint: %s\n' "${base_url}"
    printf 'model: %s\n' "${model}"
    printf 'FIM format: %s\n' "${fim_format}"
    printf 'prompt cache: entries=%s bytes=%s\n' \
      "${prompt_cache_size}" "${prompt_cache_bytes}"
    if service_loaded; then
      printf 'launchd: loaded (%s)\n' "${service_target}"
      launchctl print "${service_target}" 2>/dev/null |
        awk '/^[[:space:]]*(state|pid|last exit code) =/ { sub(/^[[:space:]]*/, ""); print }'
    else
      printf 'launchd: not loaded (%s)\n' "${service_target}"
      status_ok=0
    fi
    if health_response="$(curl -fsS --max-time 5 "${base_url}/health" 2>/dev/null)"; then
      printf '%s\n' "${health_response}" | print_json
    else
      printf 'health: unavailable\n'
      status_ok=0
    fi
    [ "${status_ok}" -eq 1 ]
    ;;
  health)
    curl -fsS --max-time 5 "${base_url}/health" | print_json
    ;;
  monitor)
    interval="${RETICLE_MLX_MONITOR_INTERVAL:-2}"
    validate_positive_integer "${interval}" "RETICLE_MLX_MONITOR_INTERVAL"
    while :; do
      printf '\033[2J\033[HReticle MLX monitor — %s\n' "$(date)"
      printf 'endpoint: %s\nmodel: %s\nFIM format: %s\n' \
        "${base_url}" "${model}" "${fim_format}"
      if service_loaded; then
        launchctl print "${service_target}" 2>/dev/null |
          awk '/^[[:space:]]*(state|pid|last exit code) =/ { sub(/^[[:space:]]*/, ""); print }'
      else
        printf 'launchd: not loaded\n'
      fi
      curl -fsS --max-time 2 "${base_url}/health" 2>/dev/null || printf 'health: unavailable\n'
      sleep "${interval}"
    done
    ;;
  logs)
    mkdir -p "${log_dir}"
    touch "${stdout_log}" "${stderr_log}"
    exec tail -n 100 -F "${stdout_log}" "${stderr_log}"
    ;;
  doctor)
    run_doctor
    ;;
  vscode-install)
    install_vscode_extension
    ;;
  vscode-doctor)
    run_vscode_doctor
    ;;
  uninstall)
    unload_service
    if [ -f "${plist_path}" ]; then
      rm -f "${plist_path}"
      printf 'Removed %s\n' "${plist_path}"
    fi
    printf 'The private MLX-LM environment, model cache, and logs were preserved.\n'
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

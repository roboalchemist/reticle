#!/bin/bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
version="$(node -p "require('${repo_root}/package.json').version")"
release_root="${repo_root}/build/release"
app_path="${repo_root}/build/macos/Reticle MLX.app"
zip_path="${release_root}/Reticle-MLX-${version}.zip"
dmg_path="${release_root}/Reticle-MLX-${version}.dmg"
identity="${RETICLE_CODESIGN_IDENTITY:-}"
notary_profile="${RETICLE_NOTARY_PROFILE:-reticle-mlx-notary}"

if [ -z "${identity}" ]; then
  printf 'error: RETICLE_CODESIGN_IDENTITY is required for a release\n' >&2
  exit 1
fi

case "${release_root}" in
  "${repo_root}"/build/*) ;;
  *) printf 'error: release directory escaped the repository build directory\n' >&2; exit 1 ;;
esac

RETICLE_CODESIGN_IDENTITY="${identity}" "${repo_root}/scripts/build-macos-app"
mkdir -p "${release_root}"
rm -f "${zip_path}" "${dmg_path}"

codesign --verify --deep --strict --verbose=2 "${app_path}"
codesign -d --verbose=4 "${app_path}" 2>&1 |
  grep -E '^(Identifier|Authority|TeamIdentifier|Runtime Version)='

ditto -c -k --keepParent "${app_path}" "${zip_path}"
xcrun notarytool submit "${zip_path}" --keychain-profile "${notary_profile}" --wait
xcrun stapler staple "${app_path}"
xcrun stapler validate "${app_path}"
spctl --assess --type execute --verbose=4 "${app_path}"

rm -f "${zip_path}"
ditto -c -k --keepParent "${app_path}" "${zip_path}"

hdiutil create -volname "Reticle MLX" -srcfolder "${app_path}" \
  -ov -format UDZO "${dmg_path}"
codesign --force --timestamp --sign "${identity}" "${dmg_path}"
xcrun notarytool submit "${dmg_path}" --keychain-profile "${notary_profile}" --wait
xcrun stapler staple "${dmg_path}"
xcrun stapler validate "${dmg_path}"
spctl --assess --type open --context context:primary-signature --verbose=4 "${dmg_path}"

openssl dgst -sha256 "${zip_path}" "${dmg_path}"

#!/bin/sh

set -eu

service_label="io.github.roboalchemist.reticle.mtplx"
command_name="${0##*/}"
service_uid="$(id -u)"
service_domain="gui/${service_uid}"
service_target="${service_domain}/${service_label}"
plist_path="${HOME}/Library/LaunchAgents/${service_label}.plist"
log_dir="${MTPLX_LOG_DIR:-${HOME}/.mtplx/logs}"
stdout_log="${log_dir}/reticle-mtplx.log"
stderr_log="${log_dir}/reticle-mtplx.error.log"
model="${MTPLX_MODEL:-Youssofal/Qwen3.5-9B-MTPLX-Optimized-Speed}"
port="${MTPLX_PORT:-8000}"
profile="${MTPLX_PROFILE:-sustained}"
context_window="${MTPLX_CONTEXT_WINDOW:-16384}"
kv_quantization="${MTPLX_KV_QUANTIZATION:-q4}"
fim_probe_payload='{"model":"mtplx","prompt":"<|fim_prefix|>function select(user: User) {\n  const value = user.<|fim_suffix|>;\n  return value;\n}\ninterface User { suffixOnlyIdentifier: string }\n<|fim_middle|>","max_tokens":8,"temperature":0,"stream":false,"stop":"\n"}'

usage() {
  cat <<EOF
Usage: ${command_name} COMMAND

Commands:
  install     Install MTPLX/model, create the user LaunchAgent, and wait for health
  download    Download or resume the selected model with machine-readable progress
  model-status Check whether the selected model is cached and MTPLX-compatible
  start       Load the previously installed LaunchAgent
  stop        Unload the LaunchAgent without deleting it
  restart     Restart the loaded LaunchAgent
  status      Show launchd state and the MTPLX health response
  health      Print GET /health
  monitor     Watch compact GET /metrics output until interrupted
  dashboard   Open the MTPLX dashboard
  logs        Follow service stdout and stderr
  doctor      Validate the installed service, health report, and live FIM path
  uninstall   Unload the service and remove its plist; models and caches are preserved

Environment:
  MTPLX_MODEL          Hugging Face model ID or local model path
  MTPLX_PORT           Loopback port (default: 8000)
  MTPLX_PROFILE        MTPLX runtime profile (default: sustained)
  MTPLX_CONTEXT_WINDOW Context ceiling in tokens (default: 16384)
  MTPLX_KV_QUANTIZATION Paged KV mode: off, q8, or q4 (default: q4)
  MTPLX_BIN            Absolute mtplx executable override
  MTPLX_LOG_DIR        Log directory (default: ~/.mtplx/logs)
  MTPLX_SKIP_DOWNLOAD  Set to 1 when the selected model is already cached
  MTPLX_SKIP_FIM_WARMUP Set to 1 to skip the Reticle-shaped warmup request
EOF
}

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

validate_port() {
  case "${port}" in
    ''|*[!0-9]*) fail "MTPLX_PORT must be an integer from 1 to 65535" ;;
  esac
  [ "${port}" -ge 1 ] && [ "${port}" -le 65535 ] ||
    fail "MTPLX_PORT must be an integer from 1 to 65535"
}

validate_runtime_options() {
  case "${context_window}" in
    ''|*[!0-9]*) fail "MTPLX_CONTEXT_WINDOW must be an integer of at least 4096" ;;
  esac
  [ "${context_window}" -ge 4096 ] ||
    fail "MTPLX_CONTEXT_WINDOW must be an integer of at least 4096"
  case "${kv_quantization}" in
    off|q8|q4) ;;
    *) fail "MTPLX_KV_QUANTIZATION must be off, q8, or q4" ;;
  esac
}

resolve_mtplx() {
  if [ -n "${MTPLX_BIN:-}" ]; then
    [ -x "${MTPLX_BIN}" ] || fail "MTPLX_BIN is not executable: ${MTPLX_BIN}"
    printf '%s\n' "${MTPLX_BIN}"
    return
  fi
  if command -v mtplx >/dev/null 2>&1; then
    command -v mtplx
    return
  fi
  for candidate in /opt/homebrew/bin/mtplx /usr/local/bin/mtplx; do
    if [ -x "${candidate}" ]; then
      printf '%s\n' "${candidate}"
      return
    fi
  done
  return 1
}

installed_config_value() {
  option_name="${1}"
  argument_count="$(plutil -extract ProgramArguments raw -o - "${plist_path}" 2>/dev/null)" ||
    return 1
  case "${argument_count}" in
    ''|*[!0-9]*) return 1 ;;
  esac

  argument_index=0
  while [ "${argument_index}" -lt "${argument_count}" ]; do
    argument_value="$(
      plutil -extract "ProgramArguments.${argument_index}" raw -o - "${plist_path}" 2>/dev/null
    )" || return 1
    if [ "${argument_value}" = "${option_name}" ]; then
      value_index=$((argument_index + 1))
      [ "${value_index}" -lt "${argument_count}" ] || return 1
      plutil -extract "ProgramArguments.${value_index}" raw -o - "${plist_path}" 2>/dev/null
      return
    fi
    argument_index=$((argument_index + 1))
  done
  return 1
}

load_installed_config() {
  [ -f "${plist_path}" ] || return

  if [ -z "${MTPLX_MODEL+x}" ]; then
    installed_value="$(installed_config_value --model || true)"
    [ -z "${installed_value}" ] || model="${installed_value}"
  fi
  if [ -z "${MTPLX_PROFILE+x}" ]; then
    installed_value="$(installed_config_value --profile || true)"
    [ -z "${installed_value}" ] || profile="${installed_value}"
  fi
  if [ -z "${MTPLX_PORT+x}" ]; then
    installed_value="$(installed_config_value --port || true)"
    [ -z "${installed_value}" ] || port="${installed_value}"
  fi
  if [ -z "${MTPLX_CONTEXT_WINDOW+x}" ]; then
    installed_value="$(installed_config_value --context-window || true)"
    [ -z "${installed_value}" ] || context_window="${installed_value}"
  fi
  if [ -z "${MTPLX_KV_QUANTIZATION+x}" ]; then
    installed_value="$(installed_config_value --paged-kv-quantization || true)"
    [ -z "${installed_value}" ] || kv_quantization="${installed_value}"
  fi
}

terminate_download() {
  if [ -n "${download_pid:-}" ]; then
    kill -CONT "${download_pid}" 2>/dev/null || true
    kill -TERM "${download_pid}" 2>/dev/null || true
    wait "${download_pid}" 2>/dev/null || true
  fi
  exit 143
}

download_model() {
  install_mtplx
  mtplx_path="$(resolve_mtplx)"
  download_pid=""
  trap terminate_download HUP INT TERM
  "${mtplx_path}" pull "${model}" --progress-json --json &
  download_pid=$!
  printf 'RETICLE_DOWNLOAD_WORKER\t%s\n' "${download_pid}"
  wait "${download_pid}"
  download_status=$?
  download_pid=""
  trap - HUP INT TERM
  return "${download_status}"
}

model_status() {
  mtplx_path="$(resolve_mtplx)" || fail "mtplx executable not found"
  inspection="$("${mtplx_path}" inspect "${model}" --json)" ||
    fail "model is not downloaded or inspectable: ${model}"
  can_run="$(printf '%s' "${inspection}" | json_value compatibility.can_run || true)"
  mtp_exists="$(printf '%s' "${inspection}" | json_value mtp.exists || true)"
  [ "${can_run}" = "true" ] && [ "${mtp_exists}" = "true" ] ||
    fail "model is not a runnable native-MTP model: ${model}"
  printf 'model: %s\nruntime: mtplx\nFIM format: qwen\n' "${model}"
}

install_mtplx() {
  if resolve_mtplx >/dev/null 2>&1; then
    return
  fi
  command -v brew >/dev/null 2>&1 ||
    fail "Homebrew is required. Install it from https://brew.sh, then retry."
  brew tap youssofal/mtplx
  if brew install --help 2>/dev/null | grep -q -- '--no-ask'; then
    brew install --no-ask youssofal/mtplx/mtplx
  else
    brew install youssofal/mtplx/mtplx
  fi
}

xml_escape() {
  printf '%s' "$1" |
    sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' \
      -e 's/"/\&quot;/g' -e "s/'/\&apos;/g"
}

write_plist() {
  mtplx_path="$1"
  mkdir -p "$(dirname "${plist_path}")" "${log_dir}"
  plist_tmp="$(mktemp "${plist_path}.XXXXXX")"
  escaped_bin="$(xml_escape "${mtplx_path}")"
  escaped_model="$(xml_escape "${model}")"
  escaped_profile="$(xml_escape "${profile}")"
  escaped_context_window="$(xml_escape "${context_window}")"
  escaped_kv_quantization="$(xml_escape "${kv_quantization}")"
  escaped_stdout="$(xml_escape "${stdout_log}")"
  escaped_stderr="$(xml_escape "${stderr_log}")"
  escaped_path="$(xml_escape "$(dirname "${mtplx_path}"):/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin")"
  cat >"${plist_tmp}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>${service_label}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${escaped_bin}</string>
    <string>serve</string>
    <string>--model</string>
    <string>${escaped_model}</string>
    <string>--profile</string>
    <string>${escaped_profile}</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>${port}</string>
    <string>--batching-preset</string>
    <string>latency</string>
    <string>--ssd-session-cache</string>
    <string>on</string>
    <string>--context-window</string>
    <string>${escaped_context_window}</string>
    <string>--paged-kv-quantization</string>
    <string>${escaped_kv_quantization}</string>
    <string>--default-temperature</string>
    <string>0</string>
    <string>--default-top-p</string>
    <string>1</string>
    <string>--reasoning</string>
    <string>off</string>
    <string>--reasoning-parser</string>
    <string>none</string>
    <string>--max-tokens</string>
    <string>256</string>
    <string>--warmup-tokens</string>
    <string>8</string>
    <string>--no-stats-footer</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>${escaped_path}</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>${escaped_stdout}</string>
  <key>StandardErrorPath</key>
  <string>${escaped_stderr}</string>
</dict>
</plist>
EOF
  plutil -lint "${plist_tmp}" >/dev/null
  chmod 600 "${plist_tmp}"
  mv "${plist_tmp}" "${plist_path}"
}

service_loaded() {
  launchctl print "${service_target}" >/dev/null 2>&1
}

load_service() {
  [ -f "${plist_path}" ] || fail "service is not installed: ${plist_path}"
  if service_loaded; then
    launchctl kickstart -k "${service_target}"
  else
    launchctl bootstrap "${service_domain}" "${plist_path}"
  fi
}

unload_service() {
  if service_loaded; then
    launchctl bootout "${service_target}"
    sleep 1
  fi
}

wait_for_health() {
  attempt=0
  while [ "${attempt}" -lt 300 ]; do
    if curl -fsS --max-time 2 "${base_url}/health" >/dev/null 2>&1; then
      printf 'MTPLX is healthy at %s\n' "${base_url}"
      return
    fi
    attempt=$((attempt + 1))
    sleep 2
  done
  printf 'MTPLX did not become healthy; inspect %s and %s\n' "${stdout_log}" "${stderr_log}" >&2
  exit 1
}

warm_fim_path() {
  if [ "${MTPLX_SKIP_FIM_WARMUP:-0}" = "1" ]; then
    return
  fi
  printf 'Warming the Reticle FIM request path...\n'
  curl -fsS --max-time 180 "${base_url}/v1/completions" \
    -H 'Content-Type: application/json' \
    -d "${fim_probe_payload}" >/dev/null ||
    fail "MTPLX is healthy but the Reticle FIM warmup failed; inspect ${stderr_log}"
  printf 'Reticle FIM request path is warm.\n'
}

json_value() {
  json_path="${1}"
  json_input="$(cat)"
  if json_output="$(
    printf '%s' "${json_input}" |
      plutil -extract "${json_path}" raw -o - - 2>/dev/null
  )"; then
    printf '%s\n' "${json_output}"
    return
  fi
  command -v python3 >/dev/null 2>&1 || return 1
  printf '%s' "${json_input}" |
    python3 -c '
import json
import sys

value = json.load(sys.stdin)
for component in sys.argv[1].split("."):
    value = value[int(component)] if isinstance(value, list) else value[component]
if isinstance(value, bool):
    print(str(value).lower())
elif value is not None:
    print(value)
' "${json_path}"
}

run_doctor() {
  doctor_ok=1
  printf 'Reticle MTPLX doctor\n'
  printf 'configured endpoint: %s\n' "${base_url}"
  printf 'configured model: %s\n' "${model}"
  printf 'configured runtime: profile=%s context=%s kv=%s\n' \
    "${profile}" "${context_window}" "${kv_quantization}"

  if mtplx_path="$(resolve_mtplx)"; then
    printf 'PASS executable: %s\n' "${mtplx_path}"
  else
    printf 'FAIL executable: mtplx was not found\n' >&2
    doctor_ok=0
  fi

  if [ -f "${plist_path}" ]; then
    printf 'PASS service definition: %s\n' "${plist_path}"
  else
    printf 'FAIL service definition: missing %s\n' "${plist_path}" >&2
    doctor_ok=0
  fi

  if service_loaded; then
    printf 'PASS launchd: loaded (%s)\n' "${service_target}"
  else
    printf 'FAIL launchd: not loaded (%s)\n' "${service_target}" >&2
    doctor_ok=0
  fi

  health_response=""
  if health_response="$(curl -fsS --max-time 5 "${base_url}/health")"; then
    health_ok="$(printf '%s' "${health_response}" | json_value ok || true)"
    generation_mode="$(printf '%s' "${health_response}" | json_value generation_mode || true)"
    mtp_enabled="$(printf '%s' "${health_response}" | json_value mtp_enabled || true)"
    served_model="$(printf '%s' "${health_response}" | json_value model || true)"
    served_profile="$(printf '%s' "${health_response}" | json_value profile.name || true)"
    warmup_error="$(printf '%s' "${health_response}" | json_value warmup.error || true)"
    if [ "${health_ok}" = "true" ] &&
      [ "${generation_mode}" = "mtp" ] &&
      [ "${mtp_enabled}" = "true" ] &&
      { [ -z "${warmup_error}" ] || [ "${warmup_error}" = "null" ]; }; then
      printf 'PASS health: model=%s profile=%s mode=%s mtp=%s\n' \
        "${served_model:-unknown}" "${served_profile:-unknown}" \
        "${generation_mode}" "${mtp_enabled}"
    else
      printf 'FAIL health: ok=%s mode=%s mtp=%s warmup_error=%s\n' \
        "${health_ok:-unknown}" "${generation_mode:-unknown}" \
        "${mtp_enabled:-unknown}" "${warmup_error:-none}" >&2
      doctor_ok=0
    fi
  else
    printf 'FAIL health: GET %s/health failed\n' "${base_url}" >&2
    doctor_ok=0
  fi

  fim_response=""
  if fim_response="$(curl -fsS --max-time 180 "${base_url}/v1/completions" \
    -H 'Content-Type: application/json' -d "${fim_probe_payload}")"; then
    completion="$(printf '%s' "${fim_response}" | json_value choices.0.text || true)"
    if [ "${completion}" = "suffixOnlyIdentifier" ]; then
      printf 'PASS FIM probe: suffixOnlyIdentifier\n'
    else
      printf 'FAIL FIM probe: expected suffixOnlyIdentifier, got %s\n' \
        "${completion:-no completion}" >&2
      doctor_ok=0
    fi
  else
    printf 'FAIL FIM probe: POST %s/v1/completions failed\n' "${base_url}" >&2
    doctor_ok=0
  fi

  [ "${doctor_ok}" -eq 1 ] || exit 1
  printf 'Reticle MTPLX doctor: pass\n'
}

print_json() {
  if command -v jq >/dev/null 2>&1; then
    jq .
  else
    cat
  fi
}

print_status_json() {
  if command -v jq >/dev/null 2>&1; then
    jq '{
      ok,
      model,
      generation_mode,
      mtp_enabled,
      profile: .profile.name,
      warmup: {
        ran: .warmup.ran,
        error: .warmup.error,
        tok_s: .warmup.tok_s
      },
      load_time_s,
      requests_completed,
      idle_seconds,
      session_cache: {
        mode: .ssd_session_cache.mode,
        entries: .ssd_session_cache.entries,
        bytes: .ssd_session_cache.bytes
      }
    }'
  else
    cat
  fi
}

command="${1:-}"
case "${command}" in
  start|restart|status|health|monitor|dashboard|doctor)
    load_installed_config
    ;;
esac
base_url="http://127.0.0.1:${port}"
validate_port
validate_runtime_options
case "${command}" in
  install)
    install_mtplx
    mtplx_path="$(resolve_mtplx)"
    if [ "${MTPLX_SKIP_DOWNLOAD:-0}" != "1" ]; then
      "${mtplx_path}" setup --model "${model}" --download --force
    fi
    unload_service
    write_plist "${mtplx_path}"
    load_service
    wait_for_health
    warm_fim_path
    ;;
  download)
    download_model
    ;;
  model-status)
    model_status
    ;;
  start)
    load_service
    wait_for_health
    warm_fim_path
    ;;
  stop)
    unload_service
    printf 'MTPLX service stopped; plist preserved at %s\n' "${plist_path}"
    ;;
  restart)
    load_service
    wait_for_health
    warm_fim_path
    ;;
  status)
    status_ok=1
    printf 'endpoint: %s\nmodel: %s\nruntime: mtplx\nFIM format: qwen\n' \
      "${base_url}" "${model}"
    if service_loaded; then
      printf 'launchd: loaded (%s)\n' "${service_target}"
      launchctl print "${service_target}" 2>/dev/null |
        awk '/^[[:space:]]*(state|pid|last exit code) =/ { sub(/^[[:space:]]*/, ""); print }'
    else
      printf 'launchd: not loaded (%s)\n' "${service_target}"
      status_ok=0
    fi
    if health_response="$(curl -fsS --max-time 5 "${base_url}/health" 2>/dev/null)"; then
      printf '%s\n' "${health_response}" | print_status_json
    else
      printf 'health: unavailable\n'
      status_ok=0
    fi
    [ "${status_ok}" -eq 1 ]
    ;;
  health)
    curl -fsS --max-time 5 "${base_url}/health" | print_json
    ;;
  monitor)
    mtplx_path="$(resolve_mtplx)" || fail "mtplx executable not found"
    exec "${mtplx_path}" metrics watch --url "${base_url}" --interval "${MTPLX_MONITOR_INTERVAL:-1}"
    ;;
  dashboard)
    open "${base_url}/"
    ;;
  logs)
    mkdir -p "${log_dir}"
    touch "${stdout_log}" "${stderr_log}"
    exec tail -n 100 -F "${stdout_log}" "${stderr_log}"
    ;;
  doctor)
    run_doctor
    ;;
  uninstall)
    unload_service
    if [ -f "${plist_path}" ]; then
      rm -f "${plist_path}"
      printf 'Removed %s\n' "${plist_path}"
    fi
    printf 'MTPLX itself, downloaded models, session cache, and logs were preserved.\n'
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

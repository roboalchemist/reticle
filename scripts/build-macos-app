#!/bin/bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
package_dir="${repo_root}/macos/ReticleMLX"
build_root="${RETICLE_BUILD_DIR:-${repo_root}/build/macos}"
app_path="${build_root}/Reticle MLX.app"
contents_path="${app_path}/Contents"
version="$(node -p "require('${repo_root}/package.json').version")"
build_number="${RETICLE_BUILD_NUMBER:-${version}}"
identity="${RETICLE_CODESIGN_IDENTITY:--}"
sparkle_feed_url="${RETICLE_SPARKLE_FEED_URL:-}"
sparkle_public_key="${RETICLE_SPARKLE_PUBLIC_ED_KEY:-}"

case "${build_root}" in
  "${repo_root}"/build/*) ;;
  *) printf 'error: RETICLE_BUILD_DIR must be under %s/build\n' "${repo_root}" >&2; exit 1 ;;
esac

swift build --package-path "${package_dir}" -c release --arch arm64
binary_dir="$(swift build --package-path "${package_dir}" -c release --arch arm64 --show-bin-path)"

rm -rf "${app_path}" "${build_root}/AppIcon.iconset"
mkdir -p "${contents_path}/MacOS" "${contents_path}/Resources" "${build_root}/AppIcon.iconset"

cp "${binary_dir}/ReticleMLX" "${contents_path}/MacOS/ReticleMLX"
cp "${repo_root}/scripts/reticle-mlx" "${contents_path}/Resources/reticle-mlx"
cp "${repo_root}/media/menu-bar-icon@2x.png" "${contents_path}/Resources/MenuBarIcon.png"
cp "${package_dir}/Info.plist" "${contents_path}/Info.plist"
chmod 755 "${contents_path}/MacOS/ReticleMLX" "${contents_path}/Resources/reticle-mlx"

sparkle_framework="$(
  find "${package_dir}/.build/artifacts/sparkle/Sparkle" \
    -path '*/Sparkle.framework' -type d -print -quit
)"
if [ -z "${sparkle_framework}" ]; then
  printf 'error: Sparkle.framework was not produced by Swift Package Manager\n' >&2
  exit 1
fi
mkdir -p "${contents_path}/Frameworks"
cp -R "${sparkle_framework}" "${contents_path}/Frameworks/Sparkle.framework"

plutil -replace CFBundleShortVersionString -string "${version}" "${contents_path}/Info.plist"
plutil -replace CFBundleVersion -string "${build_number}" "${contents_path}/Info.plist"
if [ -n "${sparkle_feed_url}" ]; then
  plutil -insert SUFeedURL -string "${sparkle_feed_url}" "${contents_path}/Info.plist"
fi
if [ -n "${sparkle_public_key}" ]; then
  plutil -insert SUPublicEDKey -string "${sparkle_public_key}" "${contents_path}/Info.plist"
fi

icon_source="${repo_root}/media/app-icon-1024.png"
iconset="${build_root}/AppIcon.iconset"
for size in 16 32 128 256 512; do
  sips -z "${size}" "${size}" "${icon_source}" \
    --out "${iconset}/icon_${size}x${size}.png" >/dev/null
  retina_size=$((size * 2))
  sips -z "${retina_size}" "${retina_size}" "${icon_source}" \
    --out "${iconset}/icon_${size}x${size}@2x.png" >/dev/null
done
iconutil -c icns "${iconset}" -o "${contents_path}/Resources/AppIcon.icns"

if [ "${identity}" = "-" ]; then
  codesign --force --deep --sign - "${app_path}"
else
  codesign --force --deep --strict --options runtime --timestamp \
    --entitlements "${package_dir}/ReticleMLX.entitlements" \
    --sign "${identity}" "${app_path}"
fi

codesign --verify --deep --strict --verbose=2 "${app_path}"
printf '%s\n' "${app_path}"
